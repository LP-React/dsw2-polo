            "cwd": "${workspaceFolder}/bibliotec-api",
            "mainClass": "com.bibliotec.BibliotecApplication",
            "projectName": "bibliotec",
            "args": "",
            "envFile": "${workspaceFolder}/bibliotec-api/.env"
        },
        {
            "type": "java",
            "name": "Servidor Eureka",
