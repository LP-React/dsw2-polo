    ],
    "compounds": [
        {
            "name": "BIBLIO-TEC completo (Eureka + Backend)",
            "configurations": [
                "Servidor Eureka",
                "Backend BIBLIO-TEC"
            ],
            "stopAll": true
        }
    ]
}
