<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://bibliotec.com/soap/libros"
           xmlns:tns="http://bibliotec.com/soap/libros"
           elementFormDefault="qualified">

    <xs:element name="consultarDisponibilidadRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="idLibro" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="consultarDisponibilidadResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="idLibro" type="xs:long"/>
                <xs:element name="titulo" type="xs:string"/>
                <xs:element name="cantidad" type="xs:int"/>
                <xs:element name="disponible" type="xs:boolean"/>
                <xs:element name="mensaje" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
